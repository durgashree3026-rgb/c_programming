#include<stdio.h>

    struct student {
        int roll;
        char name[50];
        float marks;
    };
    int main()
    {
        struct student s ={101,"durga",95.3};
        struct student *ptr =&s;
        
        printf("%d\n",ptr->roll);
        printf("%s\n",ptr->name);
        printf("%.1f",ptr->marks);
        
        return 0;
    }
