#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    
    int arr[n];
    int sum =0;
    int avg;
    //read data
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    //traverse array
    for(int i=0;i<n;i++)
    {
        sum = sum +arr[i];
    }
    avg = sum/n;
    printf("Avarege of the array:%d",avg);
    return 0;
    
}
