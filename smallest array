#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    int sml = arr[0];
    
    //read the array
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    //smallest array
    for(int i=0;i<n;i++)
    {
      if(arr[i]<sml)
      {
          sml = arr[i];
      }
    }
    printf("%d",sml);
    return 0;
}
