#include<stdio.h>
#include<string.h>

struct student
{
    int roll_no;
    char name[50];
    float mark;
};

//function
int detail(struct student s)
{
  printf("\nRoll no:%d",s.roll_no);
  printf("\nName:%s",s.name);;
  printf("\nMark:%.2f",s.mark);
  return 0;
}
//main
int main()
{
    struct student s;
    int result;
    scanf("%d",&s.roll_no);
    scanf("%s",s.name);
    scanf("%f",&s.mark);
    
    //display 
    
    detail(s);
    return 0;
}
