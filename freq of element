#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    int count;
    //read array
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    
    //searching
    for(int i=0;i<n;i++)
    {
        
        count =1;
        if(arr[i]==-1)
        {
           continue;
        }
        for(int j=i+1;j<n;j++)
        {
            if(arr[i]==arr[j])
            {
                count++;
                arr[j]=-1;
                
            }
        }
       printf("Frequency of element %d:%d\n",arr[i],count); 
    }
    
    return 0;
}
