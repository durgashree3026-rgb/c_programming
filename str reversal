#include<stdio.h>
#include<string.h>

int main()
{
    char str[60];
    fgets(str,sizeof(str),stdin);
    
    int len =strlen(str);
    int temp;
    //array reversal
    for(int i=0;i<len/2;i++)
    {
      temp = str[i];
      str[i] =str[len-1-i];
      str[len-1-i] = temp;
    }
    printf("%s",str);
    return 0;
}
