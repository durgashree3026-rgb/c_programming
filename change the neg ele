#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    //check whether the negative numbers
    for(int i=0;i<n;i++)
    {
        if(arr[i]<0)
        {
            arr[i]=0;
        }
    }
    //display array
    for(int i=0;i<n;i++)
    {
        printf("\n%d",arr[i]);
    }
    return 0;
}
