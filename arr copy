#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    int copy[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    //array copy
    for(int i=0;i<n;i++)
    {
        copy[i]=arr[i];
    }
    for(int i=0;i<n;i++)
    {
        printf("%d ",copy[i]);
    }
    return 0;
}
