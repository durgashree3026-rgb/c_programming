#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int arr[n];
    int even_count =0;
    int odd_count =0;
    
    
    //read array
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    //even odd
    for(int i=0;i<n;i++)
    {
        if(arr[i]%2==0)
        {
           even_count++;
        }
        else
        {
            odd_count++;
        }
    }
    printf("\n%d %d",even_count,odd_count);
    return 0;

}
