#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    
    int arr[n];
    
    
    //array read
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
    }
    int target;
    scanf("%d",&target);
    
    for(int i=0;i<n;i++)
    {
        if(arr[i]==target)
        {
             printf("\nTarget was found at the index %d",i);
             
             return 0;
        }
    }
    
    printf("\nTarget not found");
    return 0;
    
}
