#include<stdio.h>
int main()
{
    //array declaration
    int n;
    scanf("%d",&n);
    int arr[n];
    
    for(int i=0;i<n;i++)
    {
        scanf("%d",&arr[i]);
        
    }
    //reversal
    
    for(int i=0;i<n/2;i++)
    {
        int temp = arr[i];
        arr[i]  = arr[n-i-1];
        arr[n-i-1] = temp;
        
    }
    
    //printing a array
    for(int i=0;i<n;i++)
    {
        printf("%d ",arr[i]);
    }
    return 0;
}
