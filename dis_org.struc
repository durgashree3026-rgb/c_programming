#include<stdio.h>
#include<math.h>

struct orgin
{
    float x_axis;
    float y_axis;
};
//function
float axis(struct orgin o)
{
    return sqrt((o.x_axis*o.x_axis) + (o.y_axis*o.y_axis));
}
//main
int main()
{
    struct orgin o;
    float distance;
    //get data
    scanf("%f",&o.x_axis);
    scanf("%f",&o.y_axis);
    //functon call
    distance = axis(o);
    //display
    printf("Distance:%.2f",distance);
    return 0;
    
    
}
